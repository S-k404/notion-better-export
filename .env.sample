# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Or run `nbe init` to store the token privately without a .env file.

# Notion Internal Integration Secret (starts with ntn_ or secret_)
NOTION_TOKEN=ntn_your_notion_integration_token_here

# Where `nbe auto` writes. Pick ONE of the two (EXPORT_OUT_DIR wins if both set):
#   EXPORT_OUT_DIR - exact folder to write into
#   VAULT_PATH     - your Obsidian vault root; exports into "<vault>/Notion Better Export"
EXPORT_OUT_DIR=./output
# VAULT_PATH=~/Documents/Obsidian Vault
